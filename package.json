{
  "name": "livekit-broadcast",
  "version": "0.1.0",
  "private": true,
  "description": "Room, stage and broadcast control plane for a self-hosted LiveKit deployment",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@livekit/protocol": "^1.50.4",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "livekit-server-sdk": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
